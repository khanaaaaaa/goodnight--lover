use_bpm 82
use_synth :piano

with_fx :reverb, room: 0.8, mix: 0.6 do
    play 67, amp: 0.25, release: 2
    sleep 0.5
    play 59, amp: 0.5
    sleep 0.4
    play 64, amp: 0.4
    sleep 0.5

    play 63, amp: 0.6
    sleep 0.5
    play 57, amp: 0.7
    sleep 0.1
    play 45, amp: 0.5
    sleep 0.5

    play 43, amp: 0.2
    sleep 0.5
    play 54, amp: 0.5
    sleep 0.5
end

in_thread do
    8.times do
        with_fx :reverb, room: 1, mix: 0.65, damp: 0.85 do
            use_synth :piano

            play 60, amp: 0.35
            sleep 1

            play 64, amp: 0.25
            sleep 1

            play 67, amp: 0.20
            sleep 1

            play 64, amp: 0.25
            sleep 1
        end
    end
end

live_loop :low_notes do
    sleep 4

    with_fx :reverb, room: 1, mix: 0.8 do
        use_synth :piano

        play 43, amp: 0.12
        sleep 2

        play 40, amp: 0.10
        sleep 2
    end
end

in_thread do
    use_synth :prophet

    with_fx :reverb, room: 1, mix: 0.75 do
        play_chord [55, 60, 64], amp: 0.16, attack: 1.5, release: 4
        sleep 4

        play_chord [52, 59, 64], amp: 0.14, attack: 1.5, release: 4
        sleep 4

        play_chord [55, 60, 67], amp: 0.16, attack: 1.5, release: 4
        sleep 4

        play_chord [57, 60, 64], amp: 0.13, attack: 1.5, release:4
        sleep 4
    end
end

